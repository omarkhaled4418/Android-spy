# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Authentication (Bearer token for API security - generate your own secure key)
API_KEY=your_secure_api_key_here

# Ngrok Public URL / Reverse Proxy Tunnel (Optional)
# Example: https://your-subdomain.ngrok-free.dev
NGROK_URL=

# Storage & Maintenance
SCREENSHOT_DIR=./screenshots
HEARTBEAT_TIMEOUT_SECONDS=45
